# E-posta/şifre üyeliği için API anahtarı gerekmez.
# DB (D1) ve BUCKET (R2) sunucu bağlantıları kullanılır.

# Canlı alan adını değiştirirsen paylaşım bağlantılarının ana adresi:
# APP_PUBLIC_URL=https://anime-takvimi-production.up.railway.app

# İsteğe bağlı: Railway volume anahtarları yerine kendi VAPID çiftin.
# PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY=
# PUSH_SUBJECT=https://anime-takvimi-production.up.railway.app
# Birden fazla yerel D1 dosyası varsa: PUSH_LOCAL_DB=mutlak_dosya_yolu
